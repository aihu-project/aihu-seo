{
  "name": "@aihu/seo",
  "version": "1.0.6",
  "description": "DEPRECATED compatibility shim over @aihu-plugin/agent-readiness (sitemap.xml, robots.txt, llms.txt, JSON-LD).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "install-manifest.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aihu/plugin": "^0.1.1",
    "@aihu/server": "^0.6.0",
    "@aihu-plugin/agent-readiness": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "rolldown": "^1.0.0-rc.17",
    "rolldown-plugin-dts": "^0.23.2",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu-seo.git"
  },
  "homepage": "https://github.com/aihu-project/aihu-seo#readme",
  "bugs": "https://github.com/aihu-project/aihu-seo/issues",
  "publishConfig": {
    "access": "public"
  }
}
